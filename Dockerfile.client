# Multi-stage build for DTLS VPN Client
FROM ubuntu:22.04 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libssl-dev \
    liburing-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy source files
COPY CMakeLists.txt .
COPY include/ include/
COPY src/ src/
COPY certs/ certs/

# Build the project
RUN mkdir build && cd build && \
    cmake .. && \
    make client

# Runtime stage
FROM ubuntu:22.04

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    liburing2 \
    iproute2 \
    iputils-ping \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create directory for certificates
RUN mkdir -p /app/certs

# Copy binary from builder
COPY --from=builder /build/build/client /app/client

# Copy certificates (optional CA cert for verification)
COPY --from=builder /build/certs/ /app/certs/

# Set working directory
WORKDIR /app

# Add capabilities for TUN device creation
# Note: Container must be run with --cap-add=NET_ADMIN --device=/dev/net/tun

# Default command (override with actual server IP and port)
# Example: docker run --cap-add=NET_ADMIN --device=/dev/net/tun client-image 192.168.1.100 4433 10.8.0.1
CMD ["./client", "server", "4433", "10.8.0.1"]

